            <column caption='KPI-NightsUnder7HRS' datatype='real' name='[Calculation_0112008180457478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;    IF [include_primary_sleep_analysis]&#10;       AND NOT ISNULL([sleep_duration_hours])&#10;    THEN&#10;        IF [sleep_duration_hours] &lt; 7 THEN 1.0&#10;        ELSE 0.0&#10;        END&#10;    END&#10;)' />
