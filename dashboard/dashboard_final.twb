      <aliases enabled='yes' />
      <column caption='KPI-MeanSleepIndv' datatype='real' name='[Calculation_0112008180203524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [include_primary_sleep_analysis] THEN&#10;        [sleep_duration_hours]&#10;    END&#10;)' />
      </column>
      <column caption='KPI-SleepVariability' datatype='real' name='[Calculation_0112008180355077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV(&#10;    IF [include_primary_sleep_analysis] THEN&#10;        [sleep_duration_hours]&#10;    END&#10;)' />
      </column>
      <column caption='KPI-NightsUnder7HRS' datatype='real' name='[Calculation_0112008180457478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF [include_primary_sleep_analysis]&#10;       AND NOT ISNULL([sleep_duration_hours])&#10;    THEN&#10;        IF [sleep_duration_hours] &lt; 7 THEN 1.0&#10;        ELSE 0.0&#10;        END&#10;    END&#10;)' />
      </column>
      <column caption='KPI-Observation' datatype='integer' name='[Calculation_0112008180535303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;    IF [include_primary_sleep_analysis] THEN&#10;        [sleep_duration_hours]&#10;    END&#10;)' />
      </column>
      <column caption='ObservationNumber' datatype='integer' name='[Calculation_0112008198004745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='SleepDevFromMean' datatype='real' name='[Calculation_0340912779792384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([primary_sleep_duration_hours])&#10;-&#10;WINDOW_AVG(AVG([primary_sleep_duration_hours]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='BelowAverageColor' datatype='string' name='[Calculation_0340912781635587]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0340912779792384] &lt; 0 THEN&#10;    &quot;Below Average&quot;&#10;ELSE&#10;    &quot;Above Average&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CaffeineCtg' datatype='string' name='[Calculation_0340912791040004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([caffeine_mg]) THEN&#10;    &quot;Unknown&quot;&#10;ELSEIF [caffeine_mg] = 0 THEN&#10;    &quot;None (0 mg)&quot;&#10;ELSEIF [caffeine_mg] &lt;= 100 THEN&#10;    &quot;Low (1-100 mg)&quot;&#10;ELSEIF [caffeine_mg] &lt;= 200 THEN&#10;    &quot;Moderate (101-200 mg)&quot;&#10;ELSE&#10;    &quot;High (&gt;200 mg)&quot;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_0626235715022848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[include_primary_sleep_analysis] AND NOT ISNULL([primary_sleep_duration_hours])' />
      </column>
      <column caption='KPI-Short Sleep' datatype='real' name='[Calculation_0626235718414337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_short_sleep]) / COUNT([is_short_sleep])' />
      </column>
      <column caption='KPI-Eligible Records' datatype='real' name='[Calculation_0626235718979586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [include_primary_sleep_analysis] THEN 1 ELSE 0 END&#10;)&#10;/&#10;COUNT([source_row_index])' />
      </column>
      <column aggregation='None' caption='Primary Sleep Duration Hours (bin)' datatype='integer' name='[Primary Sleep Duration Hours (bin)]' role='dimension' type='ordinal'>
